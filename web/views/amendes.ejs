<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historique Amendes — Arki Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .amendes-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .amendes-table th {
      padding: 10px 14px; text-align: left;
      color: var(--text-muted); font-weight: 700; font-size: 11px;
      text-transform: uppercase; letter-spacing: .05em;
      border-bottom: 2px solid var(--border);
    }
    .amendes-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    .amendes-table tr:last-child td { border-bottom: none; }
    .amendes-table tr:hover td { background: rgba(244,67,54,0.04); }
    .badge-amount {
      display: inline-block;
      background: rgba(244,67,54,0.15);
      border: 1px solid rgba(244,67,54,0.3);
      color: #f44336;
      font-weight: 800;
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 12px;
    }
    .badge-admin {
      display: inline-block;
      background: rgba(124,92,252,0.12);
      border: 1px solid rgba(124,92,252,0.25);
      color: var(--accent-light);
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 12px;
      font-weight: 600;
    }
    .filters-bar {
      display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end;
      margin-bottom: 18px;
    }
    .filters-bar .field { display: flex; flex-direction: column; gap: 4px; }
    .filters-bar label { font-size: 11px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; }
    .filters-bar input, .filters-bar select {
      padding: 7px 12px; border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg-input); color: var(--text-primary);
      font-size: 13px; min-width: 140px;
    }
    .stat-cards {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px; margin-bottom: 24px;
    }
    .stat-card {
      background: var(--bg-input); border: 1px solid var(--border);
      border-radius: 12px; padding: 14px 18px;
    }
    .stat-card .sc-label { font-size: 11px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-bottom: 4px; }
    .stat-card .sc-val { font-size: 22px; font-weight: 800; color: #fff; }
    .sc-val.red { color: #f44336; }
    .empty-state { text-align: center; padding: 48px 0; color: var(--text-muted); }
    .empty-state .emoji { font-size: 40px; margin-bottom: 12px; }
    .tag-reason {
      max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      color: var(--text-muted); font-size: 12px;
    }
    @media (max-width: 700px) {
      .amendes-table td:nth-child(4), .amendes-table th:nth-child(4) { display: none; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <%- include('sidebar', { path: '/economy/amendes', role, botUser, discordUser }) %>
    <main class="main-content">
      <div class="page-header">
        <h1>🚨 Historique des amendes</h1>
        <p>Toutes les amendes infligées via <code>/amende</code></p>
      </div>

      <!-- Stats -->
      <div class="stat-cards">
        <div class="stat-card">
          <div class="sc-label">Total amendes</div>
          <div class="sc-val" id="stat-count">—</div>
        </div>
        <div class="stat-card">
          <div class="sc-label">💎 Prélevés</div>
          <div class="sc-val red" id="stat-total">—</div>
        </div>
        <div class="stat-card">
          <div class="sc-label">Admins actifs</div>
          <div class="sc-val" id="stat-admins">—</div>
        </div>
        <div class="stat-card">
          <div class="sc-label">Dernière amende</div>
          <div class="sc-val" style="font-size:14px;line-height:1.4" id="stat-last">—</div>
        </div>
      </div>

      <!-- Filtres -->
      <div class="card">
        <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <h2>📋 Liste des amendes</h2>
          <button class="btn btn-secondary" onclick="exportCSV()" style="font-size:12px;padding:6px 14px;">⬇️ Exporter CSV</button>
        </div>
        <div class="card-body">
          <div class="filters-bar">
            <div class="field">
              <label>Recherche joueur / motif</label>
              <input type="text" id="filter-search" placeholder="Nom, ID ou motif…" oninput="applyFilters()">
            </div>
            <div class="field">
              <label>Admin</label>
              <select id="filter-admin" onchange="applyFilters()">
                <option value="">— Tous —</option>
              </select>
            </div>
            <div class="field">
              <label>Date début</label>
              <input type="date" id="filter-from" onchange="applyFilters()">
            </div>
            <div class="field">
              <label>Date fin</label>
              <input type="date" id="filter-to" onchange="applyFilters()">
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <button class="btn btn-secondary" onclick="resetFilters()" style="font-size:12px;padding:7px 14px;">✕ Réinitialiser</button>
            </div>
          </div>

          <div id="table-wrap">
            <table class="amendes-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Joueur</th>
                  <th>🛡️ Admin</th>
                  <th>💎 Montant</th>
                  <th>Motif</th>
                </tr>
              </thead>
              <tbody id="amendes-tbody">
                <tr><td colspan="5" class="empty-state"><div class="emoji">⏳</div>Chargement…</td></tr>
              </tbody>
            </table>
          </div>

          <div style="margin-top:12px;font-size:12px;color:var(--text-muted);" id="result-count"></div>
        </div>
      </div>

    </main>
  </div>

  <script>
    let allAmendes = [];

    async function loadAmendes() {
      try {
        const res = await fetch('/inventory/api/transactions?limit=2000');
        const data = await res.json();
        // Filtrer uniquement les amendes
        allAmendes = (data.transactions || [])
          .filter(t => t.reason && t.reason.startsWith('Amende :'))
          .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

        buildAdminFilter();
        updateStats(allAmendes);
        renderTable(allAmendes);
      } catch(e) {
        document.getElementById('amendes-tbody').innerHTML =
          '<tr><td colspan="5" class="empty-state"><div class="emoji">❌</div>Erreur de chargement</td></tr>';
      }
    }

    function getAdminDisplay(t) {
      return t.adminName || (!/^\d{17,20}$/.test(t.adminId||'') ? t.adminId : null) || t.adminId || '—';
    }
    function buildAdminFilter() {
      const admins = [...new Set(allAmendes.map(t => getAdminDisplay(t)).filter(Boolean))].sort();
      const sel = document.getElementById('filter-admin');
      admins.forEach(a => {
        const o = document.createElement('option');
        o.value = a; o.textContent = a;
        sel.appendChild(o);
      });
    }

    function updateStats(list) {
      document.getElementById('stat-count').textContent = list.length.toLocaleString('fr-FR');
      const total = list.reduce((s, t) => s + Math.abs(t.quantity || 0), 0);
      document.getElementById('stat-total').textContent = total.toLocaleString('fr-FR') + ' 💎';
      const admins = new Set(list.map(t => t.adminId).filter(Boolean)).size;
      document.getElementById('stat-admins').textContent = admins;
      if (list.length > 0) {
        const d = new Date(list[0].timestamp);
        document.getElementById('stat-last').textContent =
          d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
      } else {
        document.getElementById('stat-last').textContent = '—';
      }
    }

    function renderTable(list) {
      const tbody = document.getElementById('amendes-tbody');
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><div class="emoji">🎉</div>Aucune amende trouvée</div></td></tr>';
        document.getElementById('result-count').textContent = '';
        return;
      }

      tbody.innerHTML = list.map(t => {
        const d = new Date(t.timestamp);
        const dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit',month:'2-digit',year:'numeric'})
          + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
        const player = t.playerName || t.playerId || '—';
        const admin  = t.adminName || (!/^\d{17,20}$/.test(t.adminId||'') ? t.adminId : null) || t.adminId || '—';
        const motif = (t.reason || '').replace(/^Amende\s*:\s*/i, '');
        const amount = Math.abs(t.quantity || 0).toLocaleString('fr-FR');
        return `<tr>
          <td style="white-space:nowrap;color:var(--text-muted);font-size:12px;">${dateStr}</td>
          <td><span style="font-weight:600;">${escHtml(player)}</span></td>
          <td><span class="badge-admin">${escHtml(admin)}</span></td>
          <td><span class="badge-amount">−${amount} 💎</span></td>
          <td><div class="tag-reason" title="${escHtml(motif)}">${escHtml(motif)}</div></td>
        </tr>`;
      }).join('');

      document.getElementById('result-count').textContent =
        `${list.length} amende${list.length > 1 ? 's' : ''} affichée${list.length > 1 ? 's' : ''}`;
    }

    function applyFilters() {
      const search = document.getElementById('filter-search').value.toLowerCase();
      const admin  = document.getElementById('filter-admin').value;
      const from   = document.getElementById('filter-from').value ? new Date(document.getElementById('filter-from').value) : null;
      const to     = document.getElementById('filter-to').value   ? new Date(document.getElementById('filter-to').value + 'T23:59:59') : null;

      const filtered = allAmendes.filter(t => {
        if (admin && getAdminDisplay(t) !== admin) return false;
        const ts = new Date(t.timestamp);
        if (from && ts < from) return false;
        if (to   && ts > to)   return false;
        if (search) {
          const hay = [t.playerName, t.playerId, t.reason, t.adminId, t.adminName].join(' ').toLowerCase();
          if (!hay.includes(search)) return false;
        }
        return true;
      });

      updateStats(filtered);
      renderTable(filtered);
    }

    function resetFilters() {
      document.getElementById('filter-search').value = '';
      document.getElementById('filter-admin').value  = '';
      document.getElementById('filter-from').value   = '';
      document.getElementById('filter-to').value     = '';
      updateStats(allAmendes);
      renderTable(allAmendes);
    }

    function exportCSV() {
      const search = document.getElementById('filter-search').value.toLowerCase();
      const admin  = document.getElementById('filter-admin').value;
      const from   = document.getElementById('filter-from').value ? new Date(document.getElementById('filter-from').value) : null;
      const to     = document.getElementById('filter-to').value   ? new Date(document.getElementById('filter-to').value + 'T23:59:59') : null;
      const filtered = allAmendes.filter(t => {
        if (admin && t.adminId !== admin) return false;
        const ts = new Date(t.timestamp);
        if (from && ts < from) return false;
        if (to   && ts > to)   return false;
        if (search) {
          const hay = [t.playerName, t.playerId, t.reason, t.adminId].join(' ').toLowerCase();
          if (!hay.includes(search)) return false;
        }
        return true;
      });

      const rows = [['Date','Joueur','ID Joueur','Admin','Montant','Motif']];
      filtered.forEach(t => {
        const d = new Date(t.timestamp).toLocaleString('fr-FR');
        const motif = (t.reason || '').replace(/^Amende\s*:\s*/i, '');
        rows.push([d, t.playerName||'', t.playerId||'', getAdminDisplay(t), Math.abs(t.quantity||0), motif]);
      });
      const csv = rows.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
      const blob = new Blob(['\uFEFF' + csv], {type:'text/csv;charset=utf-8'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `amendes_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    }

    function escHtml(s) {
      return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    loadAmendes();
  </script>
</body>
</html>
