<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anniversaires — Arki Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .hidden { display: none !important; }
    .bd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    @media (max-width: 900px) { .bd-grid { grid-template-columns: 1fr; } }

    .bd-section { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px 22px; }
    .bd-section h2 { font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); margin: 0 0 16px; }

    .bd-field { margin-bottom: 14px; }
    .bd-field label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: .05em; }
    .bd-field input[type="text"], .bd-field input[type="number"], .bd-field select, .bd-field textarea {
      width: 100%; padding: 9px 12px; border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--bg-input, rgba(255,255,255,.05));
      color: var(--text-primary); font-size: 14px; box-sizing: border-box;
    }
    .bd-field textarea { min-height: 68px; resize: vertical; font-family: inherit; }
    .bd-toggle { display: flex; align-items: center; gap: 10px; }
    .bd-toggle input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent,#7c5cfc); cursor: pointer; }
    .bd-hint { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

    .bd-save-btn {
      padding: 10px 24px; border-radius: 8px; border: none;
      background: var(--accent,#7c5cfc); color: #fff; font-weight: 700; cursor: pointer; font-size: 14px;
    }
    .bd-save-btn:hover { filter: brightness(1.1); }
    .bd-test-btn {
      padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border-color);
      background: transparent; color: var(--text-muted); font-size: 13px; cursor: pointer;
    }
    .bd-test-btn:hover { background: var(--bg-hover); color: var(--text-primary); }

    /* Table anniversaires */
    .bd-table { width: 100%; border-collapse: collapse; }
    .bd-table th {
      text-align: left; padding: 10px 14px; font-size: 11px;
      text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }
    .bd-table td { padding: 11px 14px; border-bottom: 1px solid rgba(255,255,255,.04); font-size: 14px; vertical-align: middle; }
    .bd-table tr:last-child td { border-bottom: none; }
    .bd-table tr:hover td { background: rgba(255,255,255,.03); }
    .bd-del-btn {
      padding: 4px 12px; border-radius: 6px; border: 1px solid rgba(231,76,60,.4);
      background: transparent; color: #e74c3c; font-size: 12px; cursor: pointer;
    }
    .bd-del-btn:hover { background: rgba(231,76,60,.1); }
    .bd-today { background: rgba(255,107,157,.1) !important; }
    .bd-today td { color: #ff6b9d; }
    .bd-upcoming-soon { background: rgba(255,193,7,.06) !important; }

    /* Widget mois prochain */
    .bd-recap-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px 22px; margin-bottom: 24px; }
    .bd-recap-card h2 { font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); margin: 0 0 14px; }
    .bd-recap-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .bd-recap-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 8px; background: rgba(255,107,157,.07); border: 1px solid rgba(255,107,157,.15); }
    .bd-recap-date { font-weight: 700; font-size: 15px; color: #ff6b9d; min-width: 40px; }
    .bd-recap-name { font-size: 14px; color: var(--text-primary); }
    .bd-recap-age  { font-size: 12px; color: var(--text-muted); margin-left: auto; }

    .bd-enabled-on  { color: #2ecc71; font-weight: 700; }
    .bd-enabled-off { color: #e74c3c; font-weight: 700; }
    .bd-status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
    .bd-status-dot-on  { background: #2ecc71; }
    .bd-status-dot-off { background: #e74c3c; }

    .toast-ok  { display:none; padding:10px 18px; border-radius:8px; background:rgba(46,204,113,.15); border:1px solid rgba(46,204,113,.3); color:#2ecc71; font-size:13px; margin-bottom:16px; }
    .toast-err { display:none; padding:10px 18px; border-radius:8px; background:rgba(231,76,60,.12); border:1px solid rgba(231,76,60,.25); color:#e74c3c; font-size:13px; margin-bottom:16px; }
  </style>
</head>
<body>
  <%- include('sidebar', { path: '/birthdays', role, botUser, discordUser }) %>
  <main class="main-content">
    <div class="page-header">
      <h1>🎂 Système d'anniversaires</h1>
      <span>
        <span class="bd-status-dot <%= settings.enabled ? 'bd-status-dot-on' : 'bd-status-dot-off' %>"></span>
        <span class="<%= settings.enabled ? 'bd-enabled-on' : 'bd-enabled-off' %>"><%= settings.enabled ? 'Activé' : 'Désactivé' %></span>
      </span>
    </div>

    <% if (query && query.success) { %>
      <div class="toast-ok" style="display:block;">✅ <%= query.success %></div>
    <% } %>
    <% if (query && query.error) { %>
      <div class="toast-err" style="display:block;">❌ <%= query.error %></div>
    <% } %>

    <!-- ── Rattrapage d'urgence ── -->
    <div style="background:rgba(255,107,157,0.08);border:2px solid rgba(255,107,157,0.35);border-radius:14px;padding:18px 22px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-weight:800;font-size:15px;color:#ff6b9d;">⚡ Déclenchement manuel</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:3px;">Si les crons ont raté (redémarrage Railway), déclenche-les ici manuellement.</div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button id="btnForceToday" onclick="forceToday()"
          style="background:#ff6b9d;color:#fff;border:none;border-radius:10px;padding:9px 18px;font-size:13px;font-weight:700;cursor:pointer;">
          🎂 Souhaiter les anniversaires du jour
        </button>
        <button id="btnForceRecap" onclick="forceRecap()"
          style="background:#7c5cfc;color:#fff;border:none;border-radius:10px;padding:9px 18px;font-size:13px;font-weight:700;cursor:pointer;">
          📅 Publier le récap du mois
        </button>
      </div>
    </div>

    <!-- ── Widget prochains anniversaires ── -->
    <%
      const nextMonthName = monthNames[upcomingMonth - 1];
    %>
    <div class="bd-recap-card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:14px;">
        <h2 style="margin:0;">📅 Mois prochain — <%= nextMonthName %> (<%= nextMonthBirthdays.length %>)</h2>
        <button class="bd-test-btn" id="btnTestRecap" onclick="testRecap()">📢 Publier le récap maintenant</button>
      </div>
      <% if (nextMonthBirthdays.length === 0) { %>
        <p style="color:var(--text-muted);font-size:13px;">Aucun anniversaire enregistré pour <%= nextMonthName %>.</p>
      <% } else { %>
        <ul class="bd-recap-list">
          <% nextMonthBirthdays.sort((a,b) => a.day - b.day).forEach(b => { %>
            <li class="bd-recap-item">
              <span class="bd-recap-date"><%= String(b.day).padStart(2,'0') %></span>
              <span class="bd-recap-name"><%= b.username %></span>
              <% if (b.year) { %><span class="bd-recap-age"><%= currentYear - b.year + (upcomingMonth > new Date().getMonth() + 1 ? 1 : 0) %> ans</span><% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <!-- ── Paramètres ── -->
    <form method="POST" action="/birthdays/settings">
      <div class="bd-grid">
        <!-- Colonne gauche : config générale -->
        <div class="bd-section">
          <h2>⚙️ Configuration</h2>
          <div class="bd-field">
            <div class="bd-toggle">
              <input type="checkbox" name="enabled" id="enabled" <%= settings.enabled ? 'checked' : '' %>>
              <label for="enabled" style="text-transform:none;font-size:14px;color:var(--text-primary);">Activer le système d'anniversaires</label>
            </div>
          </div>
          <div class="bd-field">
            <label>Salon de publication (ID)</label>
            <input type="text" name="channelId" value="<%= settings.channelId %>" placeholder="ID du salon Discord">
            <p class="bd-hint">Salon où seront publiés les messages d'anniversaire et le récap mensuel.</p>
          </div>
          <div class="bd-field">
            <label>Rôle anniversaire (ID)</label>
            <input type="text" name="roleId" value="<%= settings.roleId %>" placeholder="ID du rôle Discord">
            <p class="bd-hint">Rôle attribué toute la journée et retiré à 23h50.</p>
          </div>
          <div class="bd-field">
            <div class="bd-toggle">
              <input type="checkbox" name="dmEnabled" id="dmEnabled" <%= settings.dmEnabled ? 'checked' : '' %>>
              <label for="dmEnabled" style="text-transform:none;font-size:14px;color:var(--text-primary);">Envoyer un DM au joueur le jour J</label>
            </div>
          </div>
          <div class="bd-field">
            <label>URL publique du dashboard <span style="font-weight:400;color:var(--text-muted);text-transform:none;">(optionnel)</span></label>
            <input type="text" name="dashboardPublicUrl" value="<%= settings.dashboardPublicUrl || '' %>" placeholder="Laissez vide pour détection automatique">
            <%
              const autoUrl = process.env.RAILWAY_PUBLIC_DOMAIN
                ? 'https://' + process.env.RAILWAY_PUBLIC_DOMAIN
                : process.env.REPLIT_DEV_DOMAIN
                  ? 'https://' + process.env.REPLIT_DEV_DOMAIN
                  : null;
              const activeUrl = (settings.dashboardPublicUrl || '').trim() || autoUrl;
            %>
            <% if (autoUrl && !settings.dashboardPublicUrl) { %>
              <p style="font-size:11px;color:#2ecc71;margin:5px 0 0;">✅ URL auto-détectée : <code><%= autoUrl %></code></p>
            <% } else if (settings.dashboardPublicUrl) { %>
              <p style="font-size:11px;color:#2ecc71;margin:5px 0 0;">✅ URL manuelle active : <code><%= settings.dashboardPublicUrl %></code></p>
            <% } else { %>
              <p style="font-size:11px;color:#f1c40f;margin:5px 0 0;">⚠️ Aucune URL détectée — les embeds Discord seront envoyés sans GIF.</p>
            <% } %>
            <% if (activeUrl) { %>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
                <% const gifNames = ['hb1','hb2','hb3','hb4','ja1','ja2','ja3','ja4']; %>
                <% gifNames.forEach(function(n) { %>
                  <a href="<%= activeUrl %>/img/birthday/<%= n %>.gif" target="_blank"
                     style="font-size:11px;color:var(--accent);text-decoration:none;border:1px solid var(--border-color);border-radius:4px;padding:2px 7px;">
                    🎞️ <%= n %>.gif
                  </a>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Colonne droite : cadeaux -->
        <div class="bd-section">
          <h2>🎁 Cadeau offert</h2>
          <div class="bd-field">
            <label>💎 Diamants</label>
            <input type="number" name="giftDiamonds" value="<%= settings.giftDiamonds %>" min="0" step="50">
          </div>
          <div class="bd-field">
            <label>🍓 Fraises</label>
            <input type="number" name="giftStrawberries" value="<%= settings.giftStrawberries %>" min="0" step="50">
          </div>
          <div class="bd-field">
            <label>Item supplémentaire (optionnel)</label>
            <%
              const catLabels = { currency: '💰 Monnaies', consumable: '🧪 Consommables', dino: '🦎 Dinos', equipment: '🎒 Équipement' };
              const grouped = {};
              itemTypes.forEach(it => {
                const cat = it.category || 'autre';
                if (!grouped[cat]) grouped[cat] = [];
                grouped[cat].push(it);
              });
            %>
            <select name="giftItemId" id="giftItemId" onchange="toggleLibreField()">
              <option value="">— Aucun item —</option>
              <% Object.entries(grouped).forEach(([cat, items]) => { %>
                <optgroup label="<%= catLabels[cat] || cat %>">
                  <% items.forEach(it => { %>
                    <option value="<%= it.id %>" <%= settings.giftItemId === it.id ? 'selected' : '' %>>
                      <%= it.emoji ? it.emoji + ' ' : '' %><%= it.name || it.id %>
                    </option>
                  <% }); %>
                </optgroup>
              <% }); %>
              <option value="__libre__" <%= settings.giftItemId === '__libre__' ? 'selected' : '' %>>✨ Item occasionnel (nom libre)</option>
            </select>
          </div>
          <div class="bd-field" id="libreNameField" style="display:<%= settings.giftItemId === '__libre__' ? 'block' : 'none' %>;">
            <label>Nom de l'item occasionnel</label>
            <input type="text" name="giftItemName" value="<%= settings.giftItemName || '' %>" placeholder="ex : Skin Exclusif Anniversaire">
            <p class="bd-hint">Ce nom sera affiché dans l'inventaire du joueur sous la forme 📦 Nom.</p>
          </div>
          <div class="bd-field">
            <label>Quantité de l'item</label>
            <input type="number" name="giftItemQty" value="<%= settings.giftItemQty %>" min="1" step="1">
          </div>
        </div>
      </div>

      <!-- Messages -->
      <div class="bd-section" style="margin-bottom:20px;">
        <h2>✉️ Messages personnalisables</h2>
        <p style="font-size:12px;color:var(--text-muted);margin:-8px 0 16px;">Variables disponibles : <code>{user}</code> (mention), <code>{age}</code> (affiche "X ans" si l'année est connue), <code>{month}</code> (pour le récap)</p>
        <div class="bd-grid">
          <div class="bd-field">
            <label>Message public (salon)</label>
            <textarea name="publicMessage"><%= settings.publicMessage %></textarea>
          </div>
          <div class="bd-field">
            <label>Message DM (privé)</label>
            <textarea name="dmMessage"><%= settings.dmMessage %></textarea>
          </div>
        </div>
        <div class="bd-field">
          <label>Message intro récap mensuel</label>
          <textarea name="monthRecapMessage" style="min-height:50px;"><%= settings.monthRecapMessage %></textarea>
        </div>
      </div>

      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <button type="submit" class="bd-save-btn">💾 Sauvegarder</button>
      </div>
    </form>

    <!-- ── Panneau de test ── -->
    <div class="bd-section" style="margin-top:20px;margin-bottom:0;border-color:rgba(255,200,0,.2);">
      <h2>🧪 Test de célébration</h2>
      <p style="font-size:13px;color:var(--text-muted);margin:-8px 0 14px;">
        Simule une célébration complète pour n'importe quel joueur : embed + GIF + rôle + toutes les récompenses.<br>
        <strong style="color:#f1c40f;">Peut être relancé autant de fois que nécessaire</strong> — pas de blocage anti-doublon.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div style="flex:1;min-width:200px;">
          <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">Joueur à tester</label>
          <select id="testUserId" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;">
            <option value="">— Sélectionner un joueur —</option>
            <% allBirthdays.forEach(b => { %>
              <option value="<%= b.user_id %>"><%= b.username %> (<%= String(b.day).padStart(2,'0') %>/<%= String(b.month).padStart(2,'0') %><%= b.year ? '/' + b.year : '' %>)</option>
            <% }); %>
          </select>
        </div>
        <button type="button" class="bd-save-btn" id="btnTestCelebrate" onclick="testCelebrate()" style="white-space:nowrap;">
          🎉 Lancer le test
        </button>
      </div>
      <div id="testResult" style="margin-top:12px;display:none;"></div>
    </div>

    <!-- ── Import en masse ── -->
    <div class="card" style="margin-top:24px;">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <h2>📥 Import en masse (DraftBot → Arki)</h2>
        <button type="button" onclick="document.getElementById('import-help').classList.toggle('hidden')"
          style="background:rgba(124,92,252,0.15);color:var(--accent-light,#a78bfa);border:1px solid rgba(124,92,252,0.3);border-radius:8px;padding:5px 12px;font-size:12px;cursor:pointer;">
          ❓ Format attendu
        </button>
      </div>
      <div class="card-body">
        <div id="import-help" class="hidden" style="background:rgba(255,255,255,0.04);border:1px solid var(--border-color);border-radius:8px;padding:14px;margin-bottom:14px;font-size:12px;color:var(--text-muted);line-height:1.8;">
          Une ligne par joueur, colonnes séparées par <code>,</code> ou <code>;</code> ou tabulation :<br>
          <code style="color:#a78bfa;">pseudo, ID_Discord, jour, mois[, année]</code><br><br>
          Exemples :<br>
          <code>TheBigLebowski, 123456789012345678, 1, 8, 1982</code><br>
          <code>AwS_StEF26; 987654321098765432; 2; 8; 2000</code><br>
          <code>CASSIOPÉE, 108417701293719 5621, 24, 8</code> ← année optionnelle<br><br>
          Les lignes commençant par <code>#</code> sont ignorées.
        </div>
        <form method="POST" action="/birthdays/import">
          <textarea name="lines" rows="8" placeholder="Colle ici la liste des anniversaires...
TheBigLebowski, 123456789012345678, 1, 8, 1982
AwS_StEF26, 987654321098765432, 2, 8, 2000"
            style="width:100%;padding:10px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:13px;font-family:monospace;resize:vertical;box-sizing:border-box;"></textarea>
          <button type="submit" style="margin-top:10px;background:#7c5cfc;color:#fff;border:none;border-radius:8px;padding:10px 22px;font-size:14px;font-weight:700;cursor:pointer;">
            📥 Importer tous les anniversaires
          </button>
        </form>
      </div>
    </div>

    <!-- ── Ajout manuel ── -->
    <div class="card" style="margin-top:24px;">
      <div class="card-header">
        <h2>➕ Ajouter un anniversaire manuellement</h2>
      </div>
      <div class="card-body">
        <!-- Recherche membre Discord pour trouver l'ID -->
        <div style="background:rgba(88,101,242,0.08);border:1px solid rgba(88,101,242,0.25);border-radius:10px;padding:14px 16px;margin-bottom:16px;">
          <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">🔍 Trouver l'ID d'un membre Discord</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <input type="text" id="member-search-input" placeholder="Tape un pseudo…" oninput="searchMember(this.value)"
              style="flex:1;min-width:180px;padding:8px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:13px;">
          </div>
          <div id="member-search-results" style="margin-top:8px;display:flex;flex-direction:column;gap:4px;"></div>
        </div>
        <form method="POST" action="/birthdays/add" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div>
            <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">Pseudo Discord <span style="color:#ef5350;">*</span></label>
            <input type="text" name="username" required placeholder="ex: TheBigLebowski" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">ID Discord <span style="color:#ef5350;">*</span></label>
            <input type="text" name="userId" required placeholder="ex: 123456789012345678" pattern="\d+" title="Uniquement des chiffres" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">Jour <span style="color:#ef5350;">*</span></label>
            <input type="number" name="day" required min="1" max="31" placeholder="1–31" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">Mois <span style="color:#ef5350;">*</span></label>
            <select name="month" required style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;box-sizing:border-box;">
              <option value="">— Choisir —</option>
              <% monthNames.forEach((mn, i) => { %><option value="<%= i+1 %>"><%= mn %></option><% }); %>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;">Année de naissance <span style="color:var(--text-muted);">(optionnel)</span></label>
            <input type="number" name="year" min="1900" max="<%= currentYear %>" placeholder="ex: 1982" style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-input,rgba(255,255,255,.05));color:var(--text-primary);font-size:14px;box-sizing:border-box;">
          </div>
          <div style="display:flex;align-items:flex-end;">
            <button type="submit" style="width:100%;background:var(--accent,#7c5cfc);color:#fff;border:none;border-radius:8px;padding:10px 18px;font-size:14px;font-weight:700;cursor:pointer;">
              💾 Enregistrer l'anniversaire
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Liste des anniversaires enregistrés ── -->
    <div class="card" style="margin-top:24px;">
      <div class="card-header">
        <h2>👥 Anniversaires enregistrés (<%= allBirthdays.length %>)</h2>
      </div>
      <div class="card-body" style="padding:0;">
        <% if (allBirthdays.length === 0) { %>
          <p style="padding:28px;text-align:center;color:var(--text-muted);">Aucun anniversaire enregistré. Les joueurs peuvent utiliser <code>/anniversaire</code> pour s'inscrire.</p>
        <% } else { %>
          <table class="bd-table">
            <thead>
              <tr>
                <th>Joueur</th>
                <th>Date</th>
                <th>Âge</th>
                <th>Enregistré le</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <%
                const todayParts = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', day: '2-digit', month: '2-digit' }).format(new Date()).split('/');
                const todayDay = parseInt(todayParts[0], 10);
                const todayMonth = parseInt(todayParts[1], 10);
              %>
              <% allBirthdays.forEach(b => { %>
                <%
                  const isToday = b.day === todayDay && b.month === todayMonth;
                  const age = b.year ? currentYear - b.year : null;
                  const dateStr = String(b.day).padStart(2,'0') + ' ' + monthNames[b.month - 1] + (b.year ? ' ' + b.year : '');
                  const regDate = b.registered_at ? new Date(Number(b.registered_at)).toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris' }) : '—';
                %>
                <tr class="<%= isToday ? 'bd-today' : '' %>">
                  <td><strong><%= isToday ? '🎂 ' : '' %><%= b.username %></strong><br><span style="font-size:11px;color:var(--text-muted);font-family:monospace;"><%= b.user_id %></span></td>
                  <td><%= dateStr %></td>
                  <td><%= age !== null ? age + ' ans' : '<span style="color:var(--text-muted);">—</span>' %></td>
                  <td style="color:var(--text-muted);font-size:13px;"><%= regDate %></td>
                  <td>
                    <form method="POST" action="/birthdays/delete" onsubmit="return confirm('Supprimer l\'anniversaire de <%= b.username %> ?')">
                      <input type="hidden" name="userId" value="<%= b.user_id %>">
                      <button type="submit" class="bd-del-btn">🗑️ Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>

  <script>
    function toggleLibreField() {
      const sel = document.getElementById('giftItemId');
      const field = document.getElementById('libreNameField');
      if (field) field.style.display = sel && sel.value === '__libre__' ? 'block' : 'none';
    }

    async function testCelebrate() {
      const userId = document.getElementById('testUserId').value;
      const btn    = document.getElementById('btnTestCelebrate');
      const result = document.getElementById('testResult');
      if (!userId) { result.style.display='block'; result.innerHTML='<span style="color:#e74c3c;">⚠️ Sélectionne un joueur d\'abord.</span>'; return; }
      btn.disabled = true; btn.textContent = '⏳ En cours…';
      result.style.display = 'none';
      try {
        const r = await fetch('/birthdays/test-celebrate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId }) });
        const d = await r.json();
        if (d.ok) {
          const res = d.result;
          const rewards = [];
          if (res.diamonds)     rewards.push(`💎 ${res.diamonds.toLocaleString('fr-FR')} diamants`);
          if (res.strawberries) rewards.push(`🍓 ${res.strawberries.toLocaleString('fr-FR')} fraises`);
          if (res.item)         rewards.push(`📦 ${res.item} ×${res.itemQty}`);
          result.innerHTML = `<div style="padding:10px 14px;border-radius:8px;background:rgba(46,204,113,.12);border:1px solid rgba(46,204,113,.25);font-size:13px;">
            ✅ Célébration envoyée pour <strong>${res.username}</strong>${res.age ? ` (${res.age} ans)` : ''} !<br>
            ${rewards.length ? 'Récompenses : ' + rewards.join(' · ') : '<span style="color:var(--text-muted);">Aucune récompense configurée</span>'}
          </div>`;
        } else {
          result.innerHTML = `<div style="padding:10px 14px;border-radius:8px;background:rgba(231,76,60,.1);border:1px solid rgba(231,76,60,.25);font-size:13px;color:#e74c3c;">❌ ${d.error}</div>`;
        }
      } catch (e) {
        result.innerHTML = `<div style="padding:10px 14px;border-radius:8px;background:rgba(231,76,60,.1);font-size:13px;color:#e74c3c;">❌ Erreur réseau</div>`;
      }
      result.style.display = 'block';
      btn.disabled = false; btn.textContent = '🎉 Lancer le test';
    }

    async function testRecap() {
      const btn = document.getElementById('btnTestRecap');
      if (btn) btn.disabled = true;
      try {
        const r = await fetch('/birthdays/test-recap', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const d = await r.json();
        alert(d.ok ? '✅ Récap publié !' : '❌ Erreur : ' + d.error);
      } catch (e) { alert('❌ Erreur réseau'); }
      if (btn) btn.disabled = false;
    }

    async function forceToday() {
      if (!confirm('Déclencher maintenant les souhaits d\'anniversaire du jour ?\n(rôle, cadeau, message Discord)')) return;
      const btn = document.getElementById('btnForceToday');
      btn.disabled = true; btn.textContent = '⏳ En cours…';
      try {
        const r = await fetch('/birthdays/force-today', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const d = await r.json();
        alert(d.ok ? '✅ Souhaits du jour déclenchés ! Vérifie le salon anniversaire.' : '❌ Erreur : ' + d.error);
      } catch (e) { alert('❌ Erreur réseau : ' + e.message); }
      btn.disabled = false; btn.textContent = '🎂 Souhaiter les anniversaires du jour';
    }

    let _searchTimer = null;
    async function searchMember(val) {
      clearTimeout(_searchTimer);
      const box = document.getElementById('member-search-results');
      if (!val || val.length < 2) { box.innerHTML = ''; return; }
      _searchTimer = setTimeout(async () => {
        box.innerHTML = '<div style="font-size:12px;color:var(--text-muted);padding:4px 0;">🔍 Recherche…</div>';
        try {
          const r = await fetch('/birthdays/search-member?q=' + encodeURIComponent(val));
          const d = await r.json();
          if (!d.ok || !d.results.length) {
            box.innerHTML = d.error
              ? `<div style="font-size:12px;color:#ffa726;padding:4px 0;">⚠️ ${d.error}</div>`
              : '<div style="font-size:12px;color:var(--text-muted);padding:4px 0;">Aucun membre trouvé</div>';
            return;
          }
          box.innerHTML = d.results.map(m => `
            <div onclick="pickMember('${m.id}','${m.displayName.replace(/'/g,"\\'")}','${m.username.replace(/'/g,"\\'")}') "
              style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:8px;cursor:pointer;background:rgba(255,255,255,0.04);border:1px solid var(--border-color);"
              onmouseover="this.style.background='rgba(124,92,252,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
              <img src="${m.avatar}" style="width:28px;height:28px;border-radius:50%;object-fit:cover;" onerror="this.style.display='none'">
              <div>
                <div style="font-size:13px;font-weight:600;">${m.displayName}</div>
                <div style="font-size:11px;color:var(--text-muted);">@${m.username} · <code style="user-select:all;">${m.id}</code></div>
              </div>
              <span style="margin-left:auto;font-size:11px;color:#7c5cfc;font-weight:600;">Utiliser →</span>
            </div>`).join('');
        } catch (e) { box.innerHTML = '<div style="font-size:12px;color:#ef5350;">Erreur réseau</div>'; }
      }, 300);
    }
    function pickMember(id, displayName, username) {
      const usernameInput = document.querySelector('input[name="username"]');
      const userIdInput   = document.querySelector('input[name="userId"]');
      if (usernameInput) usernameInput.value = displayName;
      if (userIdInput)   userIdInput.value   = id;
      document.getElementById('member-search-input').value = '';
      document.getElementById('member-search-results').innerHTML =
        `<div style="font-size:12px;color:#66bb6a;padding:4px 0;">✅ @${username} (${id}) — copié dans le formulaire</div>`;
    }

    async function forceRecap() {
      if (!confirm('Publier maintenant le récap des anniversaires du mois ?')) return;
      const btn = document.getElementById('btnForceRecap');
      btn.disabled = true; btn.textContent = '⏳ En cours…';
      try {
        const r = await fetch('/birthdays/test-recap', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const d = await r.json();
        alert(d.ok ? '✅ Récap du mois publié dans le salon !' : '❌ Erreur : ' + d.error);
      } catch (e) { alert('❌ Erreur réseau : ' + e.message); }
      btn.disabled = false; btn.textContent = '📅 Publier le récap du mois';
    }
  </script>
</body>
</html>
