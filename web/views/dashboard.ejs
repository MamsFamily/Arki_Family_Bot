<%
function top5Html(top5) {
  if (!top5 || top5.length === 0) {
    return '<div class="empty-state"><div class="icon">🗳️</div><p>Impossible de récupérer le classement.<br>Vérifiez l\'URL API dans les paramètres.</p></div>';
  }
  var medals = ['🥇','🥈','🥉','4️⃣','5️⃣'];
  var colors = ['#ffd700','#c0c0c0','#cd7f32','var(--text-secondary)','var(--text-secondary)'];
  var maxVotes = top5[0].votes || 1;
  var html = '<div class="top5-list">';
  top5.forEach(function(player, i) {
    var pct = maxVotes > 0 ? Math.round((player.votes / maxVotes) * 100) : 0;
    var podium = i < 3 ? 'top5-podium' : '';
    var border = i < 3 ? 'border-left:4px solid ' + colors[i] + ';' : '';
    html += '<div class="top5-row ' + podium + '" style="' + border + '">';
    html += '<div class="top5-rank" style="color:' + colors[i] + '">' + medals[i] + '</div>';
    html += '<div class="top5-name">' + player.playername + '</div>';
    html += '<div class="top5-votes"><span class="top5-votes-count">' + player.votes + '</span>';
    html += '<span class="top5-votes-label"> vote' + (player.votes > 1 ? 's' : '') + '</span></div>';
    html += '<div class="top5-bar-wrap"><div class="top5-bar" style="width:' + pct + '%;background:' + colors[i] + '"></div></div>';
    html += '</div>';
  });
  html += '</div>';
  return html;
}
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord - Arki Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('sidebar') %>
    <main class="main-content">
      <div class="dashboard-hero">
        <div>
          <span class="dashboard-eyebrow">ARKI FAMILY · CENTRE DE CONTRÔLE</span>
          <h1>Vue d'ensemble</h1>
          <p>Les informations essentielles et les accès rapides au même endroit.</p>
          <div class="dashboard-status"><span class="status-dot"></span> <%= botUser ? 'Bot Discord connecté' : 'Dashboard disponible · bot géré séparément' %> <span class="status-separator">·</span> Session <%= Math.floor(uptime / 3600) %>h<%= Math.floor((uptime % 3600) / 60).toString().padStart(2, '0') %></div>
        </div>
        <img src="/images/logo-brut.png" alt="" class="dashboard-hero-logo">
      </div>

      <section class="dashboard-section" aria-labelledby="quick-title">
        <div class="dashboard-section-heading"><div><span class="section-kicker">ACCÈS RAPIDES</span><h2 id="quick-title">Que voulez-vous gérer ?</h2></div></div>
        <div class="dashboard-shortcuts">
          <a href="/welcome" class="dashboard-shortcut"><span class="shortcut-icon">👋</span><span><strong>Communauté</strong><small>Arrivées, départs et messages</small></span><span class="shortcut-arrow">↗</span></a>
          <a href="/tickets" class="dashboard-shortcut"><span class="shortcut-icon">🎫</span><span><strong>Modération</strong><small>Tickets et demandes</small></span><span class="shortcut-arrow">↗</span></a>
          <a href="/shop" class="dashboard-shortcut"><span class="shortcut-icon">🛒</span><span><strong>Boutique</strong><small>Produits et inventaires</small></span><span class="shortcut-arrow">↗</span></a>
          <a href="/settings" class="dashboard-shortcut"><span class="shortcut-icon">⚙️</span><span><strong>Configuration</strong><small>Paramètres du bot</small></span><span class="shortcut-arrow">↗</span></a>
        </div>
      </section>

      <section class="dashboard-section" aria-labelledby="community-title">
        <div class="dashboard-section-heading"><div><span class="section-kicker">COMMUNAUTÉ</span><h2 id="community-title">Votre serveur <small><%= typeof welcomeStats !== 'undefined' ? welcomeStats.month : '' %></small></h2></div><a href="/welcome" class="section-action">Gérer les membres ↗</a></div>
        <div class="dashboard-metrics">
          <div class="dashboard-metric"><span>Membres actuels</span><strong><%= memberCount.toLocaleString('fr-FR') %></strong></div>
          <% if (typeof welcomeStats !== 'undefined') { %>
          <div class="dashboard-metric"><span>Arrivées ce mois</span><strong><%= welcomeStats.joins %></strong></div>
          <div class="dashboard-metric"><span>Départs ce mois</span><strong><%= welcomeStats.leaves %></strong></div>
          <div class="dashboard-metric"><span>Évolution nette</span><strong class="<%= welcomeStats.net >= 0 ? 'metric-positive' : 'metric-negative' %>"><%= welcomeStats.net >= 0 ? '+' : '' %><%= welcomeStats.net %></strong></div>
          <% } %>
        </div>
      </section>

      <section class="dashboard-section" aria-labelledby="votes-title">
        <div class="dashboard-section-heading"><div><span class="section-kicker">VOTES</span><h2 id="votes-title">Classement du mois</h2></div><a href="/votes" class="section-action">Voir les votes ↗</a></div>
        <div class="dashboard-votes-summary">
          <span>🏆 Premier du classement <strong id="stat-votes-first"><%= top5.length > 0 ? top5[0].votes : '—' %></strong> votes</span>
          <span>🗳️ Total du top 5 <strong id="stat-votes-total"><%= top5.reduce((s, p) => s + p.votes, 0).toLocaleString('fr-FR') %></strong> votes</span>
        </div>
      <div class="card">
        <div class="card-header">
          <h2>🏆 Top 5 voteurs — mois en cours</h2>
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:13px;color:var(--text-muted)">Via Top-Serveurs</span>
            <button id="top5-refresh-btn" onclick="refreshTop5()" style="background:none;border:1px solid var(--border-color);border-radius:6px;padding:3px 10px;cursor:pointer;font-size:12px;color:var(--text-secondary);">↻ Actualiser</button>
            <span id="top5-updated" style="font-size:11px;color:var(--text-muted)"></span>
          </div>
        </div>
        <div class="card-body" id="top5-body">
          <%- top5Html(top5) %>
        </div>
      </div>
      </section>

    </main>
  </div>

<script>
  var TOP5_MEDALS = ['🥇','🥈','🥉','4️⃣','5️⃣'];
  var TOP5_COLORS = ['#ffd700','#c0c0c0','#cd7f32','var(--text-secondary)','var(--text-secondary)'];

  function top5HtmlJS(top5) {
    if (!top5 || top5.length === 0) {
      return '<div class="empty-state"><div class="icon">🗳️</div><p>Impossible de récupérer le classement.<br>Vérifiez l\'URL API dans les paramètres.</p></div>';
    }
    var maxVotes = top5[0].votes || 1;
    var html = '<div class="top5-list">';
    top5.forEach(function(player, i) {
      var pct = maxVotes > 0 ? Math.round((player.votes / maxVotes) * 100) : 0;
      var podium = i < 3 ? 'top5-podium' : '';
      var border = i < 3 ? 'border-left:4px solid ' + TOP5_COLORS[i] + ';' : '';
      html += '<div class="top5-row ' + podium + '" style="' + border + '">';
      html += '<div class="top5-rank" style="color:' + TOP5_COLORS[i] + '">' + TOP5_MEDALS[i] + '</div>';
      html += '<div class="top5-name">' + escHtml(player.playername) + '</div>';
      html += '<div class="top5-votes"><span class="top5-votes-count">' + player.votes + '</span>';
      html += '<span class="top5-votes-label"> vote' + (player.votes > 1 ? 's' : '') + '</span></div>';
      html += '<div class="top5-bar-wrap"><div class="top5-bar" style="width:' + pct + '%;background:' + TOP5_COLORS[i] + '"></div></div>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  function refreshTop5() {
    var btn = document.getElementById('top5-refresh-btn');
    if (btn) { btn.textContent = '⏳'; btn.disabled = true; }
    fetch('/api/top5')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (btn) { btn.textContent = '↻ Actualiser'; btn.disabled = false; }
        var top5 = data.top5 || [];

        var body = document.getElementById('top5-body');
        if (body) body.innerHTML = top5HtmlJS(top5);

        var elFirst = document.getElementById('stat-votes-first');
        if (elFirst) elFirst.textContent = top5.length > 0 ? top5[0].votes : '—';

        var elTotal = document.getElementById('stat-votes-total');
        if (elTotal) elTotal.textContent = top5.reduce(function(s, p) { return s + p.votes; }, 0).toLocaleString('fr-FR');

        var upd = document.getElementById('top5-updated');
        if (upd && data.updatedAt) {
          var d = new Date(data.updatedAt);
          upd.textContent = 'Mis à jour à ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
      })
      .catch(function() {
        if (btn) { btn.textContent = '↻ Actualiser'; btn.disabled = false; }
      });
  }

  setInterval(refreshTop5, 30 * 60 * 1000);

</script>

</body>
</html>
