<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#171b20">
  <title>Espace membres — Arki Family</title>
  <link rel="stylesheet" href="/css/member-shop.css">
</head>
<body class="member-shop-page member-login-page">
  <main class="member-login-wrap">
    <section class="member-login-card" aria-labelledby="login-title">
      <a class="member-login-brand" href="/" aria-label="Arki Family">
        <img src="/images/logo-brut.png" alt="Arki Family">
      </a>
      <p class="shop-eyebrow"><span class="shop-eyebrow-rule"></span> Communauté ARK</p>
      <h1 id="login-title">Espace membres<br><em>Arki Family</em></h1>
      <p class="member-login-description">Connectez-vous avec Discord pour accéder aux rayons de la boutique réservés aux membres de la communauté.</p>
      <% if (error) { %>
        <div class="shop-alert member-login-alert" role="alert">
          <span class="shop-alert-mark" aria-hidden="true">!</span>
          <p><%= error %></p>
        </div>
      <% } %>
      <a class="member-login-button" href="/boutique/auth/discord">
        <span class="member-login-button-mark" aria-hidden="true">D</span>
        <span>Continuer avec Discord</span>
        <span class="shop-button-arrow" aria-hidden="true">→</span>
      </a>
      <p class="member-login-footnote">Votre compte Discord permet de vérifier votre accès à l’espace membres.</p>
    </section>
    <footer class="member-login-footer">Arki Family <span>·</span> Survivre ensemble</footer>
  </main>
</body>
</html>
