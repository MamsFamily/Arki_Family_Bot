    <% } %>
    <a href="/logout" class="nav-link">
      <span class="icon">🚪</span> Déconnexion
    </a>
  </div>
</aside>
<script>
  (function() {
    var search = document.getElementById('navSearch');
    var nav = document.querySelector('.sidebar-nav');
    var groups = Array.from(nav.querySelectorAll('.nav-group'));
    var openBeforeSearch = [];
    search.addEventListener('input', function() {
      var query = search.value.trim().toLocaleLowerCase('fr');
      if (query && !search.dataset.filtering) {
        openBeforeSearch = groups.filter(function(group) { return group.open; });
        search.dataset.filtering = 'true';
      }
      var found = 0;
      groups.forEach(function(group) {
        var matches = 0;
        group.querySelectorAll('.nav-link').forEach(function(link) {
          var match = !query || link.textContent.toLocaleLowerCase('fr').includes(query);
          link.hidden = !match;
          if (match) matches++;
        });
        group.hidden = !!query && !matches;
        if (query) group.open = matches > 0;
        else group.open = openBeforeSearch.includes(group);
        found += matches;
      });
      if (!query) delete search.dataset.filtering;
      document.getElementById('navSearchEmpty').hidden = !query || found > 0;
    });
  })();
</script>
